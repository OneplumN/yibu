{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "一步",
  "version": "0.1.5",
  "identifier": "com.yibu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "一步",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 12
        },
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "today-step",
        "title": "今日",
        "url": "/today-step",
        "width": 440,
        "height": 620,
        "minWidth": 360,
        "minHeight": 520,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 12
        },
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "today-step-handle",
        "title": "今日",
        "url": "/today-step-handle",
        "width": 48,
        "height": 156,
        "minWidth": 48,
        "minHeight": 156,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
